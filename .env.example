# URL pública de Vibrix. Por defecto ya apunta al deploy real
# (https://vibrix-app.netlify.app); usar solo para previews o staging.
NEXT_PUBLIC_APP_URL=

# URL pública de esta web; Vercel proporciona VERCEL_URL para las previews.
NEXT_PUBLIC_SITE_URL=

# Solo servidor. Crear un segmento dedicado y las propiedades de texto
# song_language, signup_locale y waitlist_interest en Resend.
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
